# Copy to .env and adjust for your machine.

# SQLite by default. Swap for e.g. postgresql+psycopg2://user:pass@host/db later.
DATABASE_URL=sqlite:///./property_cloner.db

# Path to the .edgerc file with [production] and [shared] sections.
# Relative paths resolve against backend/ regardless of cwd. Copy your .edgerc
# to backend/.edgerc (gitignored) so it isn't scattered in your home directory.
EDGERC_PATH=./.edgerc
EDGERC_SECTION_PRODUCTION=production
EDGERC_SECTION_SHARED=shared

# CORS origin for the local Vite dev server.
FRONTEND_ORIGIN=http://localhost:5173

# Choose smtp (default) or graph for Microsoft Entra application authentication.
MAIL_PROVIDER=smtp

# Microsoft Graph: fill these in the ignored .env only. Use the client secret
# VALUE, not its ID. Requires application Mail.Send permission/admin consent and
# an authorized sender mailbox. SMTP settings below are not used in graph mode.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=

# SMTP for job-outcome notifications. Keep real addresses/credentials in the
# gitignored .env, never in this example. Restart the backend after changing .env.
# localhost:25 requires a local mail server; use your approved SMTP relay instead.
# SMTP_USE_TLS enables STARTTLS (typically port 587), not implicit TLS on port 465.
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=property-cloner@example.com
